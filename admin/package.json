{
    "name": "maxi-store-admin",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "electron/main.js",
    "description": "Admin panel for Maxi Store packaged as an Electron desktop app.",
    "author": "Maxi Store",
    "scripts": {
        "dev": "vite --port 5174 --strictPort",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "postinstall": "electron-builder install-app-deps",
        "electron:dev": "concurrently \"npm:dev\" \"wait-on http://127.0.0.1:5174 --timeout 60000 && electron .\"",
        "electron:build": "vite build && electron-builder",
        "electron:pack": "vite build && electron-builder --dir",
        "electron:dist": "vite build && electron-builder --win"
    },
    "build": {
        "productName": "Maxi Store Admin",
        "appId": "com.maxistore.admin",
        "compression": "maximum",
        "protocols": [
            {
                "name": "Maxi Store Admin",
                "schemes": [
                    "maxistore-admin"
                ]
            }
        ],
        "files": [
            "dist-app/**",
            "electron/**",
            "node_modules/**",
            "package.json"
        ],
        "directories": {
            "buildResources": "build",
            "output": "release"
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "build/icon.ico",
            "requestedExecutionLevel": "asInvoker"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowElevation": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Maxi Store Admin",
            "installerIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico"
        },
        "portable": {
            "artifactName": "MaxiStoreAdmin-Portable.exe"
        },
        "asar": false
    },
    "dependencies": {
        "date-fns": "^4.1.0",
        "dompurify": "^3.3.3",
        "electron-log": "^5.4.3",
        "html2canvas": "^1.4.1",
        "i18next": "^25.7.3",
        "i18next-browser-languagedetector": "^8.2.0",
        "jsbarcode": "3.12.3",
        "jspdf": "^4.2.1",
        "keytar": "7.9.0",
        "lucide-react": "^0.561.0",
        "papaparse": "^5.4.1",
        "quill": "^2.0.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hot-toast": "^2.6.0",
        "react-i18next": "^16.5.0",
        "react-quill-new": "^3.7.0",
        "react-router-dom": "^7.0.0",
        "recharts": "^2.15.4"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.3",
        "@eslint/js": "^9.17.0",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^8.2.0",
        "electron": "^39.2.7",
        "electron-builder": "^26.7.0",
        "eslint": "^9.17.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.13.0",
        "png-to-ico": "^3.0.1",
        "sharp": "^0.34.5",
        "vite": "^6.0.3",
        "wait-on": "^8.0.0"
    }
}
