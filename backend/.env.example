# ===============================================
# TechGreen Backend - Environment Variables
# Copy these to Render Dashboard and fill in real values
# ===============================================

# SERVER CONFIGURATION
# PORT is set by Render (10000) — no need to override
NODE_ENV=production

# DATABASE CONFIGURATION (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT SECRETS (Render can auto-generate these; or generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SECURITY CONFIGURATION
ALLOWED_ORIGINS=https://techgreen.vercel.app
BCRYPT_SALT_ROUNDS=12
HMAC_SECRET=
COOKIE_SECURE=true

# TOKEN EXPIRATION
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_COOKIE_DAYS=7
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# CLIENT CONFIGURATION (your Vercel frontend URLs)
CLIENT_URL=https://techgreen.vercel.app
FRONTEND_URL=https://techgreen.vercel.app

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# CACHE CONFIGURATION
CACHE_ENABLED=true
REVALIDATION_SECRET=
STORE_URL=https://techgreen.vercel.app

# EMAIL CONFIGURATION
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# GUEPEX SHIPPING API
GUEPEX_API_ID=
GUEPEX_API_TOKEN=
GUEPEX_BASE_URL=https://api.guepex.app/v1
GUEPEX_WEBHOOK_SECRET=
GUEPEX_POLL_INTERVAL_MINUTES=15

# LOGGING
LOG_LEVEL=info
LOG_PRETTY=false
