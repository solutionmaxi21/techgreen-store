# =============================================================================
# TechGreen Store — storefront environment
# =============================================================================
# Copy to `.env.local` and fill in. Next.js reads `.env.local` in development
# and `.env` / the platform's own environment in deployment.
#
# Nothing here is committed with a real value. Every entry below is referenced
# by code — the file it is read from is named next to each one.
# =============================================================================

# -----------------------------------------------------------------------------
# API endpoints
# -----------------------------------------------------------------------------

# Public base URL of the TechGreen API, as reached **from the browser**.
# Used by: lib/api/base-url.ts
#
# In production this normally points at this same domain (the storefront
# proxies /api to the backend, see app/api/[...path]/route.ts) so that the
# session cookie stays first-party.
# Example: https://techgreen-store.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Base URL of the API as reached **from the server** (same-origin fallback,
# docker service name, or internal hostname).
# Used by: lib/api/base-url.ts
NEXT_INTERNAL_API_URL=http://backend:3001/api

# Base URL the server-side proxy and the keep-alive cron call.
# Used by: app/api/[...path]/route.ts, app/api/cron/keep-alive/route.ts
NEXT_BACKEND_URL=https://techgreen-store.onrender.com

# -----------------------------------------------------------------------------
# Third-party
# -----------------------------------------------------------------------------

# Google OAuth client ID for "Sign in with Google".
# Used by: components/google-provider.tsx
# Leave as the literal `disabled` to turn the Google button off entirely.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=disabled

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

# Shared secret for on-demand ISR revalidation (POST /api/revalidate).
# Used by: app/api/revalidate/route.ts
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=

# Key used to encrypt the offline cart held in IndexedDB.
# Used by: lib/crypto/hmac-signer.ts
#
# ⚠️  This value is prefixed NEXT_PUBLIC_ because the browser needs it, so it
# ends up in the client bundle and is NOT a secret in the usual sense. It only
# obfuscates locally cached cart data against another script on the same origin
# — it is not a substitute for server-side authorisation. Do not reuse any
# other key here. Generate with: openssl rand -hex 32
NEXT_PUBLIC_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Market / currency
# -----------------------------------------------------------------------------

# Exchange rates applied on top of config/market.ts, as a JSON object.
# Used by: config/market.ts (readEnvRates)
#
# Rates are FROM the base currency (BASE_CURRENCY in config/market.ts) TO each
# listed currency. Only currencies you list are overridden; any currency you
# omit keeps the value declared in config/market.ts.
#
# This exists so rates can be refreshed without a code change — for example
# from a scheduled job that rewrites this variable. The values in the file are
# placeholders and are NOT live market rates.
# Example: {"DZD":145,"USD":1.08}
NEXT_PUBLIC_EXCHANGE_RATES=
